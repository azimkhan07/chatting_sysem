APP_NAME="amteCHAT Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_FRONTEND_URL=http://localhost:5175

# Comma-separated list of origins allowed to call this API from a browser. Never
# a wildcard: this API holds console sessions and writes to real user accounts.
CORS_ALLOWED_ORIGINS=http://localhost:5175

# The reverse proxy this app sits behind, as an address or CIDR range. Login and
# API rate limits are counted per client IP, so this has to be set in production:
# without it every request is attributed to the proxy and one user exhausting
# the login limit locks out the entire team. Empty when there is no proxy, which
# is the local case.
TRUSTED_PROXIES=
TRUSTED_PROXY_HEADERS=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

# How long a console session stays valid, in minutes. This is the only place the
# number is defined: staff tokens are created without an explicit expiry so
# Sanctum applies this value. 720 (12 hours) covers a working day without
# leaving a live credential on a shared machine overnight.
SANCTUM_TOKEN_EXPIRATION=720

# How many devices one staff account may be signed in on at once. A new sign-in
# past this limit supersedes the oldest session.
STAFF_MAX_DEVICES=3

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Which connection this app treats as "the database". It must be `admin`:
# staff accounts and session tokens live there, so an unset DB_CONNECTION that
# fell back to the app's data would put console credentials in the user database.
DB_CONNECTION=admin

# The console database. Its own file, its own credentials, not a schema in the
# main app's database. A console compromise that reached only this file would
# have taken passwords and session tokens and nothing else.
#
# The path has to be a Docker-managed volume, not a path inside the source tree.
# Two reasons, and the second one is not theoretical:
#   1. The source tree is bind-mounted from Windows for live editing, and SQLite
#      needs POSIX advisory locking. A Windows bind mount does not provide it, so
#      concurrent requests segfault the PHP process instead of returning
#      SQLITE_BUSY. That is why compose mounts a named volume here.
#   2. Anything under /srv/database lives in the container's writable layer. A
#      `docker compose down` would take every staff password and session token
#      with it, silently, and the next boot would come up with an empty console.
# docker/compose.yaml mounts the `admin-backend-data` volume at /var/lib/console
# for exactly this file. If you must run the console without compose, put this on
# a real local filesystem and keep it out of the bind mount.
ADMIN_DB_CONNECTION=sqlite
ADMIN_DB_DATABASE=/var/lib/console/admin.sqlite

# The main app's database, read and written directly. These are not console
# credentials: a staff account with a stolen app connection could read every
# user record. Use a database user whose grants are limited to what the console
# actually needs — SELECT everywhere, and INSERT/UPDATE/DELETE only on the
# tables behind a `operations` route.
APP_DB_CONNECTION=mysql
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_DATABASE=amtechat
APP_DB_USERNAME=amtechat_admin_console
APP_DB_PASSWORD=

# Sanitized for the console: a console request never touches user sessions.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb is the main app's realtime channel. The console has nothing to
# broadcast — it is a read-mostly view over data the app owns.
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
