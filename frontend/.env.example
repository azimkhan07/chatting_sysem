# Reverb WebSocket endpoint (dev defaults match docker/compose.yaml reverb service).
VITE_REVERB_APP_KEY=amtechat-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# LiveKit media server (docker/compose.yaml -> livekit service).
VITE_LIVEKIT_URL=${VITE_LIVEKIT_URL:-ws://127.0.0.1:7880}