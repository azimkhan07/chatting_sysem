# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs / temp
*.log
tmp/
temp/

# Local databases
# These hold real records and bcrypt password hashes, and dev runs on SQLite
# (see ADR-010), so they exist in the worktree by default. `git add -A` would
# otherwise commit them.
*.sqlite
*.sqlite3
*.db

# Dependencies (each app also has its own .gitignore)
node_modules/
vendor/

# Build output
dist/
build/
coverage/
